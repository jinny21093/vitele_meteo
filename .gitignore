# БД и бэкапы — никогда не в репозитории
*.db
*.db.gz
*.db-wal
*.db-shm
backups/

# Python
__pycache__/
*.pyc
.venv/

# Конфиги с кредами — только на хосте
# (A, ревью r1-r3: мёртвый whitelist "!systemd/*" удалён — при появлении
# корневой systemd/ он пере-включил бы auth-файлы вопреки *.conf)
*.conf
auth*

# Логи и временные файлы
*.log
*.new
*.tmp
state/
