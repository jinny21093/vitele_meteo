[Unit]
Description=Remote meteo backup via ZeroTier (rsync, closes risk #1)
After=network-online.target
OnFailure=weather-report-alert.service

[Service]
Type=oneshot
User=auditbot
WorkingDirectory=/home/auditbot/weather-dash
ExecStart=/home/auditbot/weather-dash/backup_remote.sh
Nice=19
TimeoutStartSec=180
