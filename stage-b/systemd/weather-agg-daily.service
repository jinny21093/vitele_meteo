[Unit]
Description=Weather aggregates daily (v_daily + rolling events, stage B)
After=weather-collector.service

[Service]
Type=oneshot
User=auditbot
WorkingDirectory=/home/auditbot/weather-dash
ExecStart=/usr/bin/python3 /home/auditbot/weather-dash/weather_aggregator.py daily

[Install]
WantedBy=multi-user.target
